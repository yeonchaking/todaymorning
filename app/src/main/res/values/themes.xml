<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Todaymorning" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
        런처(MainActivity) 시작 테마. 앱이 실제로 뜨기 전, 시스템이 그려주는 스플래시 화면.
        로고를 바꾸고 싶으면 drawable/splash_icon.xml(또는 같은 이름의 PNG)만 교체하면 된다.
    -->
    <style name="Theme.Todaymorning.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Todaymorning</item>
    </style>
</resources>